---
import { getCollection } from "astro:content";

interface Props {
  collection: "quiz";
}

const { collection } = Astro.props;

const quizzes = await getCollection(collection, ({ data }) => import.meta.env.DEV || !data.draft);
---

<div class="post-wrapper quiz-page">
  {quizzes.map((quiz) => (
    <section class="quiz-json">
      <h1>{quiz.data.title}</h1>

      <div class="quiz-meta">
        <p class="post-subtext">Skrevet av {quiz.data.author}</p>
        <p class="post-subtext">Publisert {quiz.data.publishDate.toLocaleDateString('nb-NO')}</p>
        {quiz.data.preface ? <p>{quiz.data.preface}</p> : null}
      </div>

      <h2>Questions</h2>
      <ol>
        {Object.entries(quiz.data.quiz.questions).map(([questionId, question]) => (
          <li data-question>
            <p><strong>{question.q}</strong></p>
            <div class="quiz-options">
              {question.o.map((option) => (
                <label class="quiz-option" data-question-id={questionId} data-correct={option === question.a ? 'true' : 'false'}>
                  <input type="radio" name={`question-${questionId}`} value={option} />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  .quiz-page,
  .quiz-page * {
    font-family: var(--font-body);
  }

  .quiz-json {
    margin-bottom: var(--space-6);
  }

  .quiz-option {
    display: block;
    width: fit-content;
    min-width: 180px;
    max-width: 240px;
    padding: var(--space-2) var(--space-3);
    border-style: var(--border-style);
    border-width: var(--border-width-strong);
    border-color: var(--border-color-strong);
    cursor: pointer;
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--font-size-2);
  }

  .quiz-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .quiz-option span {
    display: block;
  }

  .quiz-option:has(input:checked)[data-correct='true'] {
    background: var(--color-success-bg);
    border-color: var(--color-success-border);
  }

  .quiz-option:has(input:checked)[data-correct='false'] {
    background: var(--color-danger-bg);
    border-color: var(--color-danger-border);
  }
</style>