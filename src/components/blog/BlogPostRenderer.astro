---
import { getCollection, render } from "astro:content";
import BlogPostWrapper from "./BlogPostWrapper.astro";
import Comments from "./Comments.astro";
import Stack from "../ui/Stack.astro";
import Tag from "../ui/Tag.astro";
import { getTagColor } from "../../lib/tags";
import { getAllComments } from "../../lib/comments";
import { getPostIdMap, postIdentityKey } from "../../lib/posts";

interface Props {
  collection: "dev" | "stian" | "anders";
}

const { collection } = Astro.props;

// Gjemmer drafts i prod, men viser dem på dev-serveren (npm run dev)
const posts = await getCollection(collection, ({ data }) => {
  const isVisible = import.meta.env.DEV || !data.draft;
  return isVisible;
});

// postId-lookup og kommentarer hentes ÉN gang for hele siden, ikke per innlegg
// (N+1). Drafts er aldri synket til Posts-tabellen, så de får ingen postId og
// dermed ingen kommentarseksjon — se oppslaget i render-loopen under.
const postIdMap = await getPostIdMap();
const commentsByPost = await getAllComments();

posts.sort((a, b) => {
  //Sorterer først på publishDate, så editDate
  const byPublish = b.data.publishDate.getTime() - a.data.publishDate.getTime(); // b - a on publishDate
  if (byPublish !== 0) return byPublish;
  const aEdit = (a.data.editDate ?? a.data.publishDate).getTime();
  const bEdit = (b.data.editDate ?? b.data.publishDate).getTime(); // same for b
  return bEdit - aEdit; // b - a on the edit dates
});

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("nb-NO", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
---

<div>
  {
    await Promise.all(
      posts.map(async (post, i) => {
        const { Content } = await render(post);
        // Samme identitet som populate-post-db.ts synker på (title, author,
        // publishDate). Mangler oppslaget finnes innlegget ikke i Posts ennå
        // (f.eks. drafts) — da rendres ingen kommentarseksjon.
        const postId = postIdMap.get(
          postIdentityKey(
            post.data.title,
            post.data.author,
            post.data.publishDate,
          ),
        );
        return (
          <BlogPostWrapper data-language={post.data.language}>
            <Stack direction="row" wrap gap="var(--space-2)">
              {post.data.tags.map((tag: string) => (
                <Tag color={getTagColor(tag)}>{tag}</Tag>
              ))}
            </Stack>
            <Content />
            <a class="post-subtext">
              Skrevet av {post.data.author} {formatDate(post.data.publishDate)}
              {post.data.editDate
                ? `, sist endret ${formatDate(post.data.editDate)}`
                : ""}
            </a>
            {postId !== undefined ? (
              <Comments
                postId={postId}
                comments={commentsByPost.get(postId) ?? []}
              />
            ) : null}
            {i < posts.length - 1 ? <hr /> : null}
          </BlogPostWrapper>
        );
      }),
    )
  }
</div>
