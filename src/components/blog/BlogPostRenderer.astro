---
import { getCollection, render } from "astro:content";
import BlogPostWrapper from "./BlogPostWrapper.astro";
import Stack from "../ui/Stack.astro";
import Tag from "../ui/Tag.astro";
import { getTagColor } from "../../lib/tags";

interface Props {
  collection: "dev" | "stian" | "anders";
}

const { collection } = Astro.props;

// Gjemmer drafts i prod, men viser dem på dev-serveren (npm run dev)
const posts = await getCollection(collection, ({ data }) => {
  const isVisible = import.meta.env.DEV || !data.draft;
  return isVisible;
});

posts.sort((a, b) => {
  //Sorterer først på publishDate, så editDate
  const byPublish = b.data.publishDate.getTime() - a.data.publishDate.getTime(); // b - a on publishDate
  if (byPublish !== 0) return byPublish;
  const aEdit = (a.data.editDate ?? a.data.publishDate).getTime();
  const bEdit = (b.data.editDate ?? b.data.publishDate).getTime(); // same for b
  return bEdit - aEdit; // b - a on the edit dates
});

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("nb-NO", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
---

<div>
  {
    await Promise.all(
      posts.map(async (post, i) => {
        const { Content } = await render(post);
        return (
          <BlogPostWrapper data-language={post.data.language}>
            <Stack direction="row" wrap gap="var(--space-2)">
              {post.data.tags.map((tag: string) => (
                <Tag color={getTagColor(tag)}>{tag}</Tag>
              ))}
            </Stack>
            <Content />
            <a class="post-subtext">
              Skrevet av {post.data.author} {formatDate(post.data.publishDate)}
              {post.data.editDate
                ? `, sist endret ${formatDate(post.data.editDate)}`
                : ""}
            </a>
            {i < posts.length - 1 ? <hr /> : null}
          </BlogPostWrapper>
        );
      }),
    )
  }
</div>
