---
import "../styles/global.css";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";

interface Props {
  song1: { songName: string; artistName: string; albumCoverLink: string } | null;
  song2: { songName: string; artistName: string; albumCoverLink: string } | null;
}

const { song1, song2 } = Astro.props;
---
<!-- Claude har skrevet layouten -->
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.svg" />
    <title>Elo</title>
  </head>
  <body>
    <Header />
    <main>
      <h1>Which is the best song?</h1>
      <div class="elo-container">
        <div class="elo-column">
          <img
            src={song1?.albumCoverLink}
            alt={`${song1?.songName} album cover`}
            class="elo-cover"
          />
          <p class="elo-song">{song1?.songName}</p>
          <p class="elo-artist">{song1?.artistName}</p>
          <button type="button" class="elo-btn">Vote for song</button>
        </div>
        <div class="elo-column">
          <img
            src={song2?.albumCoverLink}
            alt={`${song2?.songName} album cover`}
            class="elo-cover"
          />
          <p class="elo-song">{song2?.songName}</p>
          <p class="elo-artist">{song2?.artistName}</p>
          <button type="button" class="elo-btn">Vote for song</button>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  /*
    Adjust --box-width to control how much of the screen each song box fills.
    The two boxes + gap should sum to ≤ 100%.
  */
  .elo-container {
    --box-width: 30%;
    display: flex;
    justify-content: center;
    gap: 2rem;
    width: 100%;
  }

  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem;
    gap: 2rem;
  }

  h1 {
    text-align: center;
    margin: 0;
  }

  .elo-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: var(--box-width);
  }

  .elo-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .elo-song {
    font-size: 1.1rem;
    font-weight: bold;
    text-align: center;
    margin: 0;
  }

  .elo-artist {
    font-size: 0.95rem;
    text-align: center;
    margin: 0;
  }

  .elo-btn {
    border: 1px solid #222;
    background: white;
    padding: 0.5rem 1.5rem;
    font: inherit;
    cursor: pointer;
    width: 100%;
  }

  .elo-btn:hover {
    background: #f0f0f0;
  }

  @media (max-width: 600px) {
    .elo-container {
      flex-direction: column;
      align-items: center;
    }

    .elo-column {
      width: 90%;
    }
  }
</style>
