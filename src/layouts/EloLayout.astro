---
import Footer from './components/Footer.astro';
import Header from './components/Header.astro';
import Layout from './Layout.astro';
---
<!-- Claude har skrevet deler av layouten -->

<Layout>
  <div id="outer">
    <div id="header">
      <Header/>
    </div>
    <div id="elo-content">
      <slot/>
    </div>
    <div id="footer">
      <Footer/>
    </div>
  </div>
</Layout>

<style>
  #elo-content {
    padding: 50px 1rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /*
    Adjust --box-width to control how much of the screen each song box fills.
    The two boxes + gap should sum to ≤ 100%.
  */
  .elo-container {
    --box-width: 30%;
    display: flex;
    justify-content: center;
    gap: 2rem;
    width: 100%;
  }

  h1 {
    text-align: center;
    margin: 0;
  }

  .elo-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: var(--box-width);
  }

  .elo-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .elo-song {
    font-size: 1.1rem;
    font-weight: bold;
    text-align: center;
    margin: 0;
  }

  .elo-artist {
    font-size: 0.95rem;
    text-align: center;
    margin: 0;
  }

  .elo-btn {
    border: 1px solid #222;
    background: white;
    padding: 0.5rem 1.5rem;
    font: inherit;
    cursor: pointer;
    width: 100%;
  }

  .elo-btn:hover {
    background: #f0f0f0;
  }

  @media (max-width: 600px) {
    .elo-container {
      flex-direction: column;
      align-items: center;
    }

    .elo-column {
      width: 90%;
    }
  }
</style>
