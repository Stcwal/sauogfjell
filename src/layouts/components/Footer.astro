---
import FeedbackPanel from "./FeedbackPanel.astro";
import SubscribePanel from "./SubscribePanel.astro";
import Fab from "../../components/ui/Fab.astro";
---

<footer id="footer-outer">
  <div class="fab-stack">
    <Fab
      type="button"
      data-opens="feedback-dialog"
      aria-label="Gi tilbakemelding">💬</Fab
    >
    <Fab
      type="button"
      data-opens="subscribe-dialog"
      aria-label="Få varsel om nye innlegg">🔔</Fab
    >
  </div>

  <footer id="footer-inner">
    <div>
      <b>links:</b>
      <div>
        <a href="https://github.com/Stcwal/sauogfjell/">sauogfjell på github</a>
      </div>
      <div>
        <a href="https://www.linkedin.com/in/stian-closs-walmann/"
          >Stian på linkedIn</a
        >
      </div>
      <div>
        <a href="https://www.linkedin.com/in/anders-fangel/"
          >Anders på linkedIn</a
        >
      </div>
    </div>
    <div>
      <b>Sosiale medium:</b>
      <div>nei</div>
    </div>
    <div>
      <b>Takk til:</b>
      <div>Claude</div>
    </div>
  </footer>
  <FeedbackPanel />
  <SubscribePanel />
</footer>

<style>
  .fab-stack {
    position: fixed;
    bottom: var(--space-5);
    right: var(--space-5);
    z-index: var(--z-overlay);

    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
