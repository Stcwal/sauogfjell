---
import Field from "../../components/ui/Field.astro";
import Button from "../../components/ui/Button.astro";
---

<button
  id="feedback-open"
  class="feedback-fab"
  type="button"
  aria-label="Gi tilbakemelding">💬</button
>

<dialog id="feedback-dialog" class="feedback-dialog">
  <form id="feedback-form" class="feedback-form">
    <h2>Gi tilbakemelding</h2>

    <Field
      label="Tilbakemelding"
      as="textarea"
      id="feedback-text"
      required
      rows={5}
      placeholder="Skriv ris og/eller ros her"
    />

    <Field
      label="Navn (valgfritt)"
      id="feedback-author"
      type="text"
      placeholder="Ditt navn"
    />

    <p class="status" role="status"></p>

    <div class="actions">
      <Button id="feedback-close" type="button" variant="secondary">Lukk</Button
      >
      <Button type="submit" variant="primary"> Send </Button>
    </div>
  </form>
</dialog>

<script>
  // Runs on the initial load AND after every client-side (ClientRouter) navigation,
  // so the listeners get re-bound to the freshly-swapped DOM each time.
  document.addEventListener("astro:page-load", () => {
    const dialog = document.getElementById(
      "feedback-dialog",
    ) as HTMLDialogElement;
    const openBtn = document.getElementById("feedback-open");
    const closeBtn = document.getElementById("feedback-close");
    const form = document.getElementById("feedback-form") as HTMLFormElement;
    if (!dialog || !form) return;
    const statusEl = form.querySelector(".status") as HTMLElement;
    const textInput = document.getElementById(
      "feedback-text",
    ) as HTMLTextAreaElement;
    const authorInput = document.getElementById(
      "feedback-author",
    ) as HTMLInputElement;

    openBtn?.addEventListener("click", () => dialog.showModal());
    closeBtn?.addEventListener("click", () => dialog.close());

    // Close when clicking outside the form (a click whose target is the dialog itself
    // is a click on the backdrop, since the form is a child element).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const feedbackText = textInput.value;
      const author = authorInput.value;
      // The page the user is on when submitting — e.g. "/blog/dev".
      // window.location only exists in the browser, which is why this lives in the client script.
      const location = window.location.pathname;

      const res = await fetch("/api/feedback", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ author, feedbackText, location }),
      });

      if (res.ok) {
        statusEl.textContent = "Takk for tilbakemeldingen!";
        form.reset();
      } else {
        statusEl.textContent = "Noe gikk galt. Prøv igjen.";
      }
    });
  });
</script>

<style>
  /* icon-only floating button, stacked above the subscribe FAB */
  .feedback-fab {
    position: fixed;
    bottom: 5.5rem;
    right: 1.5rem;
    z-index: 10;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #222;
    border-radius: 50%;
    background: white;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .feedback-fab:hover {
    background: #f0f0f0;
  }

  .feedback-dialog {
    border: 1px solid #222;
    border-radius: 8px;
    padding: 1.5rem;
    max-width: 420px;
    width: 90%;
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .feedback-form h2 {
    margin: 0;
  }

  .status {
    margin: 0;
    min-height: 1.2em;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
</style>
