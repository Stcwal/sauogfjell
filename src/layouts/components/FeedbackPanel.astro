---
import Field from "../../components/ui/Field.astro";
import Modal from "../../components/ui/Modal.astro";
---

<Modal id="feedback-dialog" title="Gi tilbakemelding" submitLabel="Send">
  <Field
    label="Tilbakemelding"
    as="textarea"
    id="feedback-text"
    required
    rows={5}
    placeholder="Skriv ris og/eller ros her"
  />

  <Field
    label="Navn (valgfritt)"
    id="feedback-author"
    type="text"
    placeholder="Ditt navn"
  />
</Modal>

<script>
  // Only the submit handler lives here now — open/close/backdrop are handled once,
  // generically, by Modal. This still needs astro:page-load because it binds
  // directly to the form element, which ClientRouter replaces on navigation.
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById(
      "feedback-dialog-form",
    ) as HTMLFormElement;
    if (!form) return;
    const statusEl = form.querySelector(".status") as HTMLElement;
    const textInput = document.getElementById(
      "feedback-text",
    ) as HTMLTextAreaElement;
    const authorInput = document.getElementById(
      "feedback-author",
    ) as HTMLInputElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const feedbackText = textInput.value;
      const author = authorInput.value;
      // The page the user is on when submitting — e.g. "/blog/dev".
      // window.location only exists in the browser, which is why this lives in the client script.
      const location = window.location.pathname;

      const res = await fetch("/api/feedback", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ author, feedbackText, location }),
      });

      if (res.ok) {
        statusEl.textContent = "Takk for tilbakemeldingen!";
        statusEl.dataset.state = "ok";
        form.reset();
      } else {
        statusEl.textContent = "Noe gikk galt. Prøv igjen.";
        statusEl.dataset.state = "error";
      }
    });
  });
</script>
