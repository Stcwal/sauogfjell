---
import Button from "../../components/ui/Button.astro";
---

<nav aria-label="Hovedmeny">
  <a href="/">Home</a>
  <span class="toggle-slot">
    <Button id="theme-toggle">Toggle theme</Button>
    <Button id="language-toggle">Walla</Button>
  </span>
</nav>

<style>
  nav {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-inline: var(--space-4);
    font-family: var(--font-body);
  }

  /* inherit = the theme's text colour, so links work on any --color-header */
  nav a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  /* pushes the theme toggle to the far edge; the Button itself can't be
     selected from here (it carries its own scope), so its wrapper does it */
  .toggle-slot {
    margin-left: auto;
  }

  #language-toggle {
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    color: transparent;
  }

  html[data-language="norwegian"] #language-toggle {
    background-image: url(/public/flags/standard_norges_flagg.png);
  }

  html[data-language="english"] #language-toggle {
    background-image: url(/public/flags/standard_storbritannia-flagg.png);
  }
</style>
