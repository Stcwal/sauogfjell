---
import Button from "../../components/ui/Button.astro";
---

<nav aria-label="Hovedmeny">
  <a href="/">Home</a>
  <a href="/blog/dev">Dev</a>
  <a href="/blog/stian">Stian</a>
  <a href="/blog/anders">Anders</a>
  <span class="toggle-slot">
    <Button id="theme-toggle">Theme</Button>
    <Button id="language-toggle">wal</Button>
  </span>
</nav>

<style>
  nav {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-3);
    font-family: var(--font-body);
  }

  /* inherit = the theme's text colour, so links work on any --color-header */
  nav a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  /* pushes the theme toggle to the far edge; the Button itself can't be
     selected from here (it carries its own scope), so its wrapper does it */
  .toggle-slot {
    margin-left: auto;
  }

  #language-toggle {
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    color: transparent;
  }

  html[data-language="norwegian"] #language-toggle {
    background-image: url(/flags/standard_norge-flagg.png);
  }

  html[data-language="english"] #language-toggle {
    background-image: url(/flags/standard_storbritannia-flagg.png);
  }

  html[data-language="german"] #language-toggle {
    background-image: url(/flags/standard_tyskland-flagg.png);
  }
</style>
