---
import { STANDARD_TAGS } from "../../lib/tags";
import Field from "../../components/ui/Field.astro";
import Button from "../../components/ui/Button.astro";

const AUTHORS = ["stian", "anders"];
---

<button
  id="subscribe-open"
  class="subscribe-fab"
  type="button"
  aria-label="Få varsel om nye innlegg">🔔</button
>

<dialog id="subscribe-dialog" class="subscribe-dialog">
  <form id="subscribe-form" class="subscribe-form">
    <h2>Meld deg på nyhetsbrevet</h2>

    <Field
      label="E-postadresse"
      id="sub-email"
      type="email"
      placeholder="deg@eksempel.no"
    />

    {
      AUTHORS.map((author) => (
        <fieldset class="author-group">
          <legend>{author.charAt(0).toUpperCase() + author.slice(1)}</legend>
          <label>
            <input type="checkbox" data-author={author} value="alle" /> Alle
          </label>
          {STANDARD_TAGS.map((tag) => (
            <label>
              <input type="checkbox" data-author={author} value={tag} /> {tag}
            </label>
          ))}
        </fieldset>
      ))
    }

    <label class="dev-updates">
      <input id="dev-updates" type="checkbox" /> Dev-oppdateringer
    </label>

    <p class="status" role="status"></p>

    <div class="actions">
      <Button id="subscribe-close" type="button" variant="secondary"
        >Lukk</Button
      >
      <Button type="submit" variant="primary"> Meld på </Button>
    </div>
  </form>
</dialog>

<script>
  // Runs on the initial load AND after every client-side (ClientRouter) navigation,
  // so the listeners get re-bound to the freshly-swapped DOM each time.
  document.addEventListener("astro:page-load", () => {
    const dialog = document.getElementById(
      "subscribe-dialog",
    ) as HTMLDialogElement;
    const openBtn = document.getElementById("subscribe-open");
    const closeBtn = document.getElementById("subscribe-close");
    const form = document.getElementById("subscribe-form") as HTMLFormElement;
    // This panel is only on the home page; bail on pages where it isn't rendered.
    if (!dialog || !form) return;
    const statusEl = form.querySelector(".status") as HTMLElement;
    const emailInput = document.getElementById("sub-email") as HTMLInputElement;
    const devUpdatesInput = document.getElementById(
      "dev-updates",
    ) as HTMLInputElement;

    openBtn?.addEventListener("click", () => dialog.showModal());
    closeBtn?.addEventListener("click", () => dialog.close());

    // Close when clicking outside the form (a click whose target is the dialog itself
    // is a click on the backdrop, since the form is a child element).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = emailInput.value;
      const devUpdates = devUpdatesInput.checked ? 1 : 0;

      const tagsByAuthor: Record<string, string[]> = {};
      form
        .querySelectorAll<HTMLInputElement>("input[data-author]:checked")
        .forEach((el) => {
          const author = el.dataset.author!;
          (tagsByAuthor[author] ??= []).push(el.value);
        });

      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, devUpdates, tagsByAuthor }),
      });

      if (res.ok) {
        statusEl.textContent = "Gratulerer! Du er påmeldt!";
      } else {
        statusEl.textContent = "Noe gikk galt. Prøv igjen.";
      }
    });
  });
</script>

<style>
  /* icon-only floating button, bottom-right */
  .subscribe-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 10;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #222;
    border-radius: 50%;
    background: white;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .subscribe-fab:hover {
    background: #f0f0f0;
  }

  .subscribe-dialog {
    border: 1px solid #222;
    border-radius: 8px;
    padding: 1.5rem;
    max-width: 420px;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .subscribe-form h2 {
    margin: 0;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .field input {
    font: inherit;
    padding: 0.4rem;
  }

  .author-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .author-group label,
  .dev-updates {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status {
    margin: 0;
    min-height: 1.2em;
    color: #c00;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .actions button {
    font: inherit;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
  }
</style>
