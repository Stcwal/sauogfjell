---
import { STANDARD_TAGS } from "../../lib/tags";
import Field from "../../components/ui/Field.astro";
import Modal from "../../components/ui/Modal.astro";

const AUTHORS = ["stian", "anders"];
---

<Modal
  id="subscribe-dialog"
  title="Meld deg på nyhetsbrevet"
  submitLabel="Meld på"
>
  <Field
    label="E-postadresse"
    id="sub-email"
    type="email"
    required
    placeholder="deg@eksempel.no"
  />

  {
    AUTHORS.map((author) => (
      <fieldset class="author-group">
        <legend>{author.charAt(0).toUpperCase() + author.slice(1)}</legend>
        <label>
          <input type="checkbox" data-author={author} value="alle" /> Alle
        </label>
        {STANDARD_TAGS.map((tag) => (
          <label>
            <input type="checkbox" data-author={author} value={tag} /> {tag}
          </label>
        ))}
      </fieldset>
    ))
  }

  <label class="dev-updates">
    <input id="dev-updates" type="checkbox" /> Dev-oppdateringer
  </label>
</Modal>

<script>
  // Only the submit handler lives here now — open/close/backdrop are handled once,
  // generically, by Modal. This still needs astro:page-load because it binds
  // directly to the form element, which ClientRouter replaces on navigation.
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById(
      "subscribe-dialog-form",
    ) as HTMLFormElement;
    // This panel is only on the home page; bail on pages where it isn't rendered.
    if (!form) return;
    const statusEl = form.querySelector(".status") as HTMLElement;
    const emailInput = document.getElementById("sub-email") as HTMLInputElement;
    const devUpdatesInput = document.getElementById(
      "dev-updates",
    ) as HTMLInputElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = emailInput.value;
      const devUpdates = devUpdatesInput.checked ? 1 : 0;

      const tagsByAuthor: Record<string, string[]> = {};
      form
        .querySelectorAll<HTMLInputElement>("input[data-author]:checked")
        .forEach((el) => {
          const author = el.dataset.author!;
          (tagsByAuthor[author] ??= []).push(el.value);
        });

      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, devUpdates, tagsByAuthor }),
      });

      if (res.ok) {
        statusEl.textContent = "Gratulerer! Du er påmeldt!";
        statusEl.dataset.state = "ok";
      } else {
        statusEl.textContent = "Noe gikk galt. Prøv igjen.";
        statusEl.dataset.state = "error";
      }
    });
  });
</script>

<style>
  .author-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border-style: var(--border-style);
    border-width: var(--border-width-strong);
    border-color: var(--border-color-subtle);
    border-radius: var(--radius-1);
  }

  .author-group label,
  .dev-updates {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
