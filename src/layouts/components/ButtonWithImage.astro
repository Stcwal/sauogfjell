---
interface Props {
    href: string;
    src: string;
    alt: string;
    label: string;
    variant?: "feature" | "tile";
    fit?: "cover" | "contain";
}
const { href, src, alt, label, variant = "feature", fit = "cover" } = Astro.props;
---

<a href={href} class={`image-link ${variant}`}>
    <img src={src} alt={alt} style={`object-fit: ${fit};`} />
    <span class="label">{label}</span>
</a>

<style>
    .image-link {
        background: var(--btn-background);
        color: var(--btn-text);
        border-width: var(--btn-border-width);
        border-style: solid;
        border-color: var(--btn-border-color);
        border-radius: var(--btn-radius);
        box-shadow: var(--btn-shadow);
        text-decoration: none;
        display: block;
        /* clip the image's corners to the rounded border (box-shadow is unaffected) */
        overflow: hidden;
    }

    .image-link img {
        width: 100%;
        aspect-ratio: 4 / 3;
        /* object-fit is set per-image via the `fit` prop (cover | contain) */
        /* img is inline by default, which leaves a small baseline gap under it */
        display: block;
    }

    /* feature: large button, caption sits BELOW the image */
    .feature {
        display: flex;
        flex-direction: column;
    }

    .feature .label {
        padding: 0.5rem 0.75rem;
        font-family: var(--font-body);
        text-align: center;
    }

    /* tile: smaller button, label OVERLAID on the image.
       position: relative here is what the absolute label anchors to. */
    .tile {
        position: relative;
    }

    .tile .label {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 0.5rem 0.75rem;
        background: var(--tile-overlay-bg);
        color: var(--tile-overlay-text);
        font-family: var(--font-body);
        text-align: center;
    }

    /* keyboard focus ring (only shows for keyboard nav, not mouse clicks) */
    .image-link:focus-visible {
        outline: 3px solid var(--btn-border-color);
        outline-offset: 2px;
    }
</style>
