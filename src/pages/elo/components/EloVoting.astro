---
interface Props {
  song1: { songID: number; songName: string; artistName: string; albumCoverLink: string } | null;
  song2: { songID: number; songName: string; artistName: string; albumCoverLink: string } | null;
}

const { song1, song2 } = Astro.props;
---

{song1 && song2 ? (
  <>
    <h1>Hvilken sang er best?</h1>
    <div class="voting-container">
      <div class="voting-column" data-index="1">
        <img class="album-cover" src={song1.albumCoverLink} alt={`Album cover for ${song1.songName}`} />
        <p class="song-name">{song1.songName}</p>
        <p class="artist-name">{song1.artistName}</p>
        <button class="vote-btn" data-song-id={song1.songID}>Stem</button>
      </div>
      <div class="voting-column" data-index="2">
        <img class="album-cover" src={song2.albumCoverLink} alt={`Album cover for ${song2.songName}`} />
        <p class="song-name">{song2.songName}</p>
        <p class="artist-name">{song2.artistName}</p>
        <button class="vote-btn" data-song-id={song2.songID}>Stem</button>
      </div>
    </div>
    <div class="actions">
      <button class="skip-btn" type="button">Hopp over</button>
    </div>
    <p class="vote-error" role="alert"></p>
  </>
) : (
  <p>Ingen sanger tilgjengelig.</p>
)}

<script>
  interface Song {
    songID: number;
    songName: string;
    artistName: string;
    albumCoverLink: string;
  }

  const col1 = document.querySelector('.voting-column[data-index="1"]') as HTMLElement;
  const col2 = document.querySelector('.voting-column[data-index="2"]') as HTMLElement;
  const btn1 = col1.querySelector('.vote-btn') as HTMLButtonElement;
  const btn2 = col2.querySelector('.vote-btn') as HTMLButtonElement;
  const skipBtn = document.querySelector('.skip-btn') as HTMLButtonElement;
  const errorEl = document.querySelector('.vote-error') as HTMLElement;

  async function loadNewSongs() {
    const res = await fetch('/api/random-pair');
    if (!res.ok) throw new Error('Could not load new songs');

    const { song1, song2 }: { song1: Song; song2: Song } = await res.json();

    updateColumn(col1, btn1, song1);
    updateColumn(col2, btn2, song2);
  }

  async function setLoading(isLoading: boolean) {
    btn1.disabled = isLoading;
    btn2.disabled = isLoading;
    skipBtn.disabled = isLoading;
  }

  async function vote(winnerId: number, loserId: number) {
    await setLoading(true);
    btn1.disabled = true;
    btn2.disabled = true;
    errorEl.textContent = '';

    try {
      const voteRes = await fetch('/api/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ winnerId, loserId }),
      });
      if (!voteRes.ok) throw new Error('Vote failed');

      await loadNewSongs();
    } catch (err) {
      errorEl.textContent = 'Noe gikk galt. Prøv igjen.';
      console.error(err);
    } finally {
      await setLoading(false);
    }
  }

  async function skip() {
    await setLoading(true);
    errorEl.textContent = '';

    try {
      await loadNewSongs();
    } catch (err) {
      errorEl.textContent = 'Noe gikk galt. Prøv igjen.';
      console.error(err);
    } finally {
      await setLoading(false);
    }
  }

  function updateColumn(col: HTMLElement, btn: HTMLButtonElement, song: Song) {
    (col.querySelector('.album-cover') as HTMLImageElement).src = song.albumCoverLink;
    (col.querySelector('.album-cover') as HTMLImageElement).alt = `Album cover for ${song.songName}`;
    (col.querySelector('.song-name') as HTMLElement).textContent = song.songName;
    (col.querySelector('.artist-name') as HTMLElement).textContent = song.artistName;
    btn.dataset.songId = String(song.songID);
  }

  btn1.addEventListener('click', () => vote(Number(btn1.dataset.songId), Number(btn2.dataset.songId)));
  btn2.addEventListener('click', () => vote(Number(btn2.dataset.songId), Number(btn1.dataset.songId)));
  skipBtn.addEventListener('click', () => skip());
</script>

<style>
  h1 {
    text-align: center;
    margin: 0 0 1rem;
  }

  .voting-container {
    display: flex;
    gap: 2rem;
    justify-content: center;
  }

  .actions {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .voting-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 250px;
  }

  .album-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .song-name {
    font-weight: bold;
    text-align: center;
    margin: 0;
  }

  .artist-name {
    text-align: center;
    margin: 0;
    color: #555;
  }

  .vote-btn {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid #222;
    background: white;
    font: inherit;
    cursor: pointer;
  }

  .vote-btn:hover {
    background: #f0f0f0;
  }

  .skip-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #222;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .skip-btn:hover {
    background: #f0f0f0;
  }

  .vote-error {
    text-align: center;
    color: #c00;
    margin: 0;
    min-height: 1.2em;
  }

  @media (max-width: 600px) {
    .voting-container {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
