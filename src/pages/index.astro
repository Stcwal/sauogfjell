---
import HomeLayout from "../layouts/HomeLayout.astro";
import Grid from "../components/ui/Grid.astro";
import PictureCard from "../components/ui/PictureCard.astro";
---

<HomeLayout>
  <section class="landing">
    <Grid minItemWidth="21rem">
      <PictureCard
        href="/blog/stian"
        src="/landingpage/stian-placeholder.jpg"
        alt="Bilde av Stian"
        label="Stian"
      />
      <PictureCard
        href="/blog/anders"
        src="/landingpage/anders-placeholder.jpg"
        alt="Bilde av Anders"
        label="Anders"
      />
    </Grid>
    <Grid minItemWidth="9rem">
      <PictureCard
        variant="tile"
        href="/blog/dev"
        src="/landingpage/jan-thomas.jpg"
        alt="Placeholder-bilde av Jan Thomas"
        label="Dev-oppdateringer"
      />
      <PictureCard
        variant="tile"
        href="#"
        src="/landingpage/fisk.jpg"
        alt="Placeholder-bilde av en fisk"
        label="Kommer snart"
      />
      <PictureCard
        variant="tile"
        href="#"
        src="/landingpage/oljeboringsplatform.jpg"
        alt="Placeholder-bilde av en oljeboringsplattform"
        label="Kommer snart"
      />
      <PictureCard
        variant="tile"
        href="/games/"
        src="/landingpage/gameboy.gif"
        alt="Retro Game Boy"
        label="Spillsentral"
        fit="contain"
      />
    </Grid>
  </section>
</HomeLayout>

<style>
  /* centers the whole landing block and stacks the two rows vertically */
  .landing {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
