---
import ButtonWithImage from "../../layouts/components/ButtonWithImage.astro";
import HomeLayout from "../../layouts/HomeLayout.astro";
---

<HomeLayout>
  <section class="landing">
    <div class="tile-row">
      <ButtonWithImage
        variant="tile"
        href="/games/elo/"
        src="/games/noter.png"
        alt="Placeholder-bilde av Jan Thomas"
        label="Musikkrangering"
      />
      <ButtonWithImage
        variant="tile"
        href="/games/quiz/"
        src="/games/quiz.jpg"
        alt="Retro Game Boy"
        label="Quiz"
        fit="contain"
      />
      <ButtonWithImage
        variant="tile"
        href="#"
        src="/landingpage/fisk.jpg"
        alt="Placeholder-bilde av en fisk"
        label="Kommer kanskje snart?"
      />
      <ButtonWithImage
        variant="tile"
        href="#"
        src="/landingpage/oljeboringsplatform.jpg"
        alt="Placeholder-bilde av en oljeboringsplattform"
        label="Kommer kanskje snart?"
      />
    </div>
  </section>
</HomeLayout>

<style>
  /* centers the whole landing block and stacks the two rows vertically */
  .landing {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* two equal columns for the big feature buttons */
  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .tile-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem
  }

  /* on narrow screens, stack the two features instead of squishing them */
  @media (max-width: 700px) {
    .feature-row {
      grid-template-columns: 1fr;
    }

    .tile-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>